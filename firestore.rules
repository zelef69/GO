rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function ownerCanCreateProfileOnly() {
      return request.resource.data.keys().hasOnly([
        'email',
        'displayName',
        'photoURL',
        'createdAt',
        'updatedAt'
      ]);
    }

    function ownerCanCreateBootstrapUser() {
      return request.resource.data.keys().hasOnly([
        'email',
        'displayName',
        'photoURL',
        'subscription',
        'stats',
        'createdAt',
        'updatedAt'
      ]) &&
      request.resource.data.subscription is map &&
      request.resource.data.subscription.keys().hasOnly([
        'plan',
        'status',
        'startAt',
        'expireAt',
        'maxDevices',
        'extraDays',
        'version',
        'updatedAt',
        'updatedBy'
      ]) &&
      request.resource.data.subscription.plan is string &&
      request.resource.data.subscription.status is string &&
      request.resource.data.subscription.startAt is timestamp &&
      request.resource.data.subscription.expireAt is timestamp &&
      request.resource.data.subscription.maxDevices is int &&
      request.resource.data.subscription.maxDevices > 0 &&
      request.resource.data.subscription.maxDevices <= 10 &&
      request.resource.data.subscription.extraDays is int &&
      request.resource.data.subscription.extraDays >= 0 &&
      request.resource.data.subscription.version is int &&
      request.resource.data.subscription.version >= 1 &&
      request.resource.data.subscription.updatedAt is timestamp &&
      request.resource.data.subscription.updatedBy is string &&
      request.resource.data.stats is map &&
      request.resource.data.stats.keys().hasOnly(['activeDeviceCount']) &&
      request.resource.data.stats.activeDeviceCount is int &&
      request.resource.data.stats.activeDeviceCount >= 0;
    }

    function ownerCanUpdateProfileOnly() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'email',
        'displayName',
        'photoURL',
        'updatedAt'
      ]);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) &&
        (ownerCanCreateProfileOnly() || ownerCanCreateBootstrapUser());
      allow update: if isOwner(uid) && ownerCanUpdateProfileOnly();
      allow delete: if false;

      match /devices/{sessionId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /logs/{logId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /entitlements/{packageId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /purchase_history/{paymentId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /package_history/{eventId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    match /manual_correction_requests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /products/{packageId} {
      allow read: if true;
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read, write: if false;
    }

    match /app_updates/{docId} {
      allow read: if isSignedIn() && docId == 'android';
      allow write: if false;
    }

    match /crowd_meta/{docId} {
      allow read: if isSignedIn() && docId == 'current';
      allow write: if false;
    }

    match /ad_candidates/{sigHash} {
      allow read: if false;
      allow write: if false;
    }

    match /ad_signatures/{sigHash} {
      allow read: if false;
      allow write: if false;
    }

    match /ad_candidate_reports/{reportId} {
      allow read: if false;
      allow write: if false;
    }

    match /crowd_snapshot_history/{snapshotId} {
      allow read: if false;
      allow write: if false;
    }

    match /crowd_rate_limits/{uid} {
      allow read: if false;
      allow write: if false;
    }
  }
}

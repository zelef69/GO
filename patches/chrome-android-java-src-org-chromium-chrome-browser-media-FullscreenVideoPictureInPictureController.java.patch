+    @SuppressLint("PictureInPictureIssue")
+    public void refreshPictureInPictureParamsForCurrentVideo() {
+        final WebContents webContents = getWebContents();
+        if (webContents == null) {
+            Log.i(TAG, "refreshPictureInPictureParamsForCurrentVideo: no WebContents.");
+            return;
+        }
+
+        if (!webContents.hasActiveEffectivelyFullscreenVideo()) {
+            Log.i(
+                    TAG,
+                    "refreshPictureInPictureParamsForCurrentVideo: skip without active fullscreen video.");
+            return;
+        }
+
+        Log.i(
+                TAG,
+                "refreshPictureInPictureParamsForCurrentVideo: inPip=%b activeFullscreen=%b pipAllowed=%b autoEnterAllowed=%b",
+                mActivity.isInPictureInPictureMode(),
+                webContents.hasActiveEffectivelyFullscreenVideo(),
+                webContents.isPictureInPictureAllowedForFullscreenVideo(),
+                mIsAutoEnterAllowed);
+
+        final Rect bounds = getVideoBounds(webContents, mActivity);
+        if (bounds == null) {
+            Log.i(TAG, "Skip PiP params refresh without video bounds.");
+            return;
+        }
+        mLastKnownVideoBounds = new Rect(bounds);
+
+        PictureInPictureParams.Builder builder = new PictureInPictureParams.Builder();
+        if (sUseSourceRectHint) {
+            builder.setAspectRatio(new Rational(bounds.width(), bounds.height()));
+            builder.setSourceRectHint(bounds);
+        }
+        if (ENABLE_AUTO_ENTER) {
+            builder.setAutoEnterEnabled(mIsAutoEnterAllowed);
+        }
+
+        try {
+            mActivity.setPictureInPictureParams(builder.build());
+            Log.i(TAG, "Applied PiP params refresh with bounds=%s", bounds);
+            if (mActivity instanceof BraveActivity braveActivity) {
+                braveActivity.onPictureInPictureVideoParamsApplied(webContents);
+            }
+        } catch (Exception e) {
+            Log.e(TAG, "Error setting PiP params from current video bounds", e);
+        }
+    }
